# Local JSON data file that JSON Manager reads and writes.
# Use an absolute path. Backslashes are literal in .env files.
# Example (Windows): JSON_MANAGER_FILE=C:\path\to\db.json
# This seeds the active file at startup. When unset, the app still
# starts and lets you pick a file with the Choose File button.
JSON_MANAGER_FILE=

# Deployment metadata; this value is not exposed to browser code.
# Default: json-manager.rareobjectlabs.app
POC_DOMAIN=json-manager.rareobjectlabs.app